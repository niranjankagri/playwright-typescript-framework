{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "private": true,
  "description": "UI and API test automation with Playwright and TypeScript for the Practice Software Testing Toolshop",
  "author": "Niranjan Kumar Agri",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "zod": "4.6.7"
  }
}
